# OpenAI: powers /ask (chat completions) and embeddings for /ingest (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# Pinecone: vector store for /ingest and future retrieval
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=week1-ask-demo

# Only used if the index doesn't exist yet and needs to be auto-created (see
# vector_store.ensure_index). Defaults to aws / us-east-1 if unset.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Default chunking config for /ingest (RecursiveCharacterTextSplitter). Callers
# can override per-request with chunk_size / chunk_overlap in the JSON body.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
